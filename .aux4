{
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "build",
          "execute": [
            "profile:build"
          ],
          "help": {
            "text": "build the app"
          }
        },
        {
          "name": "install",
          "execute": [
            "set:os=!go env GOOS",
            "set:arch=!go env GOARCH",
            "set:version=!aux4 aux4 releaser get-version --dir ./package",
            "aux4 build $os $arch",
            "cd package && aux4 aux4 pkger build --out ../out .",
            "aux4 aux4 pkger uninstall aux4/config",
            "aux4 aux4 pkger install --fromFile out/${os}_${arch}_aux4_config_${version}.zip"
          ],
          "help": {
            "text": "install aux4/config locally"
          }
        },
        {
          "name": "release",
          "execute": [
            "rm -f out/*",
            "alias:aux4 aux4 releaser increment-version --dir ./package",
            "set:version=!aux4 aux4 releaser get-version --dir ./package",
            "aux4 build all",
            "cd package && aux4 aux4 pkger build --out ../out .",
            "aux4 aux4 pkger publish out/aux4_config_${version}.zip"
          ],
          "help": {
            "text": ""
          }
        }
      ]
    },
    {
      "name": "build",
      "commands": [
        {
          "name": "darwin",
          "execute": [
            "GOOS=darwin GOARCH=amd64 go build -o package/dist/darwin/amd64/aux4-config .",
            "GOOS=darwin GOARCH=arm64 go build -o package/dist/darwin/arm64/aux4-config ."
          ],
          "help": {
            "text": "build the app for darwin"
          }
        },
        {
          "name": "linux",
          "execute": [
            "GOOS=linux GOARCH=amd64 go build -o package/dist/linux/amd64/aux4-config .",
            "GOOS=linux GOARCH=arm64 go build -o package/dist/linux/arm64/aux4-config .",
            "GOOS=linux GOARCH=386 go build -o package/dist/linux/386/aux4-config ."
          ],
          "help": {
            "text": "build the app for linux"
          }
        },
        {
          "name": "windows",
          "execute": [
            "GOOS=windows GOARCH=amd64 go build -o package/dist/windows/amd64/aux4-config.exe .",
            "GOOS=windows GOARCH=arm64 go build -o package/dist/windows/arm64/aux4-config.exe .",
            "GOOS=windows GOARCH=386 go build -o package/dist/windows/386/aux4-config.exe ."
          ],
          "help": {
            "text": "build the app for windows"
          }
        },
        {
          "name": "all",
          "execute": [
            "aux4 build darwin",
            "aux4 build linux",
            "aux4 build windows"
          ],
          "help": {
            "text": "build the app for all platforms"
          }
        }
      ]
    }
  ]
}
